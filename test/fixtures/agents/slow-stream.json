{
  "name": "slow-stream",
  "description": "Streams 20 agent_message_chunk updates with 500 fake-ms gaps (about 10 fake seconds in total). Used to test streaming and the fake Clock; this duration is well under the default 10-minute stall timer.",
  "protocolVersion": 1,
  "initialize": {
    "result": {
      "protocolVersion": 1,
      "agentCapabilities": {
        "loadSession": true,
        "promptCapabilities": {
          "image": false,
          "audio": false,
          "embeddedContext": false
        }
      },
      "agentInfo": {
        "name": "tigercat-stub",
        "title": "TigerCat stub agent",
        "version": "0.0.0-test"
      },
      "authMethods": []
    }
  },
  "sessionId": "sess_stub_slow_stream",
  "onSessionNew": {
    "result": {
      "sessionId": "sess_stub_slow_stream"
    }
  },
  "onCancel": {
    "action": "cancel"
  },
  "onPrompt": [
